PERKPILOT_MODE=demo
PORT=3000
STORE_PORT=3001
# Optional server-side model provider; never expose a key in browser code.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# PERKPILOT_EXTENSION_ID=

# Connected services used by the full app (npm run dev). Set these in .env or deployment secrets.
# DATABASE_URL=postgresql://user:password@localhost:5432/perkpilot
# PUBLIC_ORIGIN=http://localhost:3000
# PLAID_ENV=sandbox
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_REDIRECT_URI=       # leave unset for desktop web Sandbox; add an allowlisted URL for webviews
# PLAID_TOKEN_ENCRYPTION_KEY=  # 32 random bytes, base64 encoded
# GEMINI_API_KEY=           # preferred connected assistant provider
# GEMINI_MODEL=gemini-3.8-flash
# OPENAI_API_KEY=           # optional alternative
# OPENAI_MODEL=gpt-4.1-mini
# SERPAPI_API_KEY=           # preferred broad Google Shopping catalog
# SERPAPI_LOCATION=United States  # fallback only when an account has no saved location
# SERPAPI_GL=us
# SERPAPI_HL=en
# GEOCODER_URL=https://nominatim.openstreetmap.org/reverse
# Optional catalog fallbacks:
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# SHOPIFY_STORE_DOMAIN=
# SHOPIFY_STOREFRONT_TOKEN=

# Optional Buy with PerkPilot: registered portal users, controlled store, Stripe test mode only.
# PERKPILOT_CHECKOUT_ENABLED=0
# CHECKOUT_ORIGIN=http://localhost:3000
# STRIPE_SECRET_KEY=             # sk_test_ only; never commit keys
# STRIPE_PUBLISHABLE_KEY=        # pk_test_ only
# STRIPE_EXPECTED_ACCOUNT_ID=    # acct_ identifier for the authorized sandbox
# STRIPE_WEBHOOK_SECRET=        # local Stripe CLI listener signing secret
# GEMINI_CHECKOUT_MODEL=gemini-3.8-flash
# TEST_CHECKOUT_DATABASE_URL=   # separate test database, never inferred from DATABASE_URL
# PERKPILOT_CHECKOUT_DEMO_CONTROLS=0  # explicit 1 plus local PostgreSQL fixture to arm one-shot scenarios
# CHECKOUT_VERIFY_SUBJECT=      # portal:<registered test presenter UUID>
# CHECKOUT_VERIFY_DATA_DIR=data # JSON portal identity directory for read-only verification
